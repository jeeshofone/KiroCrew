+def _proxy_for_url(url: str, proxy: str | None) -> str | None:
+    """*proxy* for *url*, or ``None`` for a loopback or ``NO_PROXY`` host.
+
+    Shared by the client and the dashboard token check so both take the same
+    route to the same host.
